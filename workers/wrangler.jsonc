{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ally-crm-connector",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "FIREBASE_PROJECT": "ally-crm-cbdd1",
    "FIREBASE_API_KEY": "AIzaSyBkjEWhqucPPFVCi5cnx_15LccgbI4B-pQ",
    "PUBLIC_ORIGIN": "https://ally-crm-connector.theallydamon.workers.dev"
  },
  "d1_databases": [{
    "binding": "AUTH_DB",
    "database_name": "ally-crm-connector-auth",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "traces": { "enabled": true, "head_sampling_rate": 0.1 } },
  "triggers": { "crons": ["13 3 * * *"] }
}
